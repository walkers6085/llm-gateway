# --- Апстрим (OpenAI-совместимый инференс) ---
# Базовый URL вместе с /v1: к нему добавляются /chat/completions, /models и т.д.
UPSTREAM_BASE_URL=https://llm.example.corp/v1
# Если апстриму кроме сертификата нужен ещё и ключ — он тоже живёт только здесь.
# UPSTREAM_API_KEY=
# UPSTREAM_TIMEOUT=300

# --- mTLS: клиентский сертификат шлюза (пути относительно папки проекта) ---
CLIENT_CERT=certs/client.crt
CLIENT_KEY=certs/client.key
# CLIENT_KEY_PASSWORD=
# CA, которыми подписан сертификат СЕРВЕРА апстрима (если не публичный); можно несколько через запятую
# CA_BUNDLE=certs/root_ca.pem,certs/intermediate_ca.pem
# Системные HTTP(S)_PROXY шлюз игнорирует. Если до апстрима нужно идти через прокси — укажите явно:
# UPSTREAM_PROXY=http://proxy.corp:8080

# --- Шлюз ---
PORT=7700
# PROD — без /docs и /openapi.json; DEV — со Swagger
GATEWAY_MODE=PROD
# DB_PATH=data/gateway.db
# Профили серверного агента (/agent/*); образец — config/agent.json.example
# AGENT_CONFIG=config/agent.json
# MAX_REQUEST_BODY_BYTES=10485760
# Лимит одновременных запросов к апстриму на модель (0 / пусто — без лимита)
# MODEL_MAX_CONNECTIONS={"my-model": 4}
# MODEL_MAX_CONNECTIONS_DEFAULT=0
# CORS нужен только если чат/клиенты открываются с другого домена
# CORS_ALLOW_ORIGINS=["https://chat.example.corp"]
